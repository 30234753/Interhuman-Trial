# Interhuman AI API Configuration
# Copy this file to .env.local and fill in your actual credentials
# Never commit .env.local to version control

# Your Interhuman AI API key ID
INTERHUMAN_API_KEY_ID=your_key_id_here

# Your Interhuman AI API key secret
INTERHUMAN_API_KEY_SECRET=your_key_secret_here

# Interhuman AI API endpoint URL (optional, defaults to https://api.interhuman.ai)
INTERHUMAN_API_URL=https://api.interhuman.ai

# Deepgram API Configuration
# Your Deepgram API key for live transcription
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Supabase Configuration
# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Your Supabase anonymous/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
